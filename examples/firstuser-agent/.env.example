SOLARI_API_KEY=your_solari_api_key

# LLM provider: "openai" (default) or "openrouter"
AI_PROVIDER=openai

# For AI_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key

# For AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your_openrouter_api_key

# Model used for both providers. Defaults to "gpt-5" if unset.
# For OpenRouter, use the provider/model format, e.g. openai/gpt-5
AI_MODEL=gpt-5
